# Server Configuration
PORT=8009
ENVIRONMENT=development

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tunorth_cpms_db
DB_SSLMODE=disable

# JWT Security
JWT_SECRET=tunorth-cpms-jwt-access-secret-2568
